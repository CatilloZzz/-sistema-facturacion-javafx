<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f7f6;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.facturacion.controller.MenuPrincipalController">

    <top>
        <VBox>
            <!-- Barra de menú con un diseño limpio y fondo blanco -->
            <MenuBar style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-width: 0 0 1 0;">
                <menus>
                    <Menu text="Archivo">
                        <items>
                            <MenuItem fx:id="mnuProductos" text="Productos" onAction="#abrirProductos"/>
                            <MenuItem fx:id="mnuSalir" text="Salir" onAction="#salir"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Barra de herramientas con padding y botones estilizados -->
            <ToolBar style="-fx-background-color: #ffffff; -fx-border-color: #dcdde1; -fx-border-width: 0 0 1 0; -fx-padding: 10 15 10 15;">
                <items>
                    <Button fx:id="btnProductos" text="📦 Productos" onAction="#abrirProductos"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>

                    <!-- Este Pane actúa como un resorte para empujar el botón "Salir" a la derecha -->
                    <Pane HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnSalir" text="🚪 Salir" onAction="#salir"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 8 16 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <!-- VBox para centrar el contenido perfectamente y agregar un subtítulo -->
        <VBox alignment="CENTER" spacing="10">
            <Label text="Sistema de Facturación"
                   style="-fx-font-size: 42px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;"/>

            <Label text="Bienvenido al panel principal"
                   style="-fx-font-size: 18px; -fx-text-fill: #7f8c8d; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;"/>

            <BorderPane.margin>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </BorderPane.margin>
        </VBox>
    </center>

</BorderPane>